{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ace-iot-solutions.github.io/ace-cdl-explorer/schemas/project-v1.json",
  "title": "ACE CDL Explorer project v1",
  "type": "object",
  "required": ["version", "name", "graph", "scenario", "layout"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "graph": { "$ref": "#/$defs/block" },
    "scenario": {
      "type": "object",
      "required": ["zone_ua_kw_per_k", "zone_capacity_kwh_per_k"],
      "properties": {
        "zone_ua_kw_per_k": { "type": "number", "exclusiveMinimum": 0 },
        "zone_capacity_kwh_per_k": { "type": "number", "exclusiveMinimum": 0 },
        "zone_infiltration_m3_s": { "type": "number", "minimum": 0, "maximum": 5, "default": 0.01 },
        "open_window_additional_infiltration_m3_s": { "type": "number", "minimum": 0, "maximum": 5, "default": 0.2 },
        "heat_pump_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "heat_pump_capacity_kw": { "type": "number", "exclusiveMinimum": 0, "default": 80 },
        "boiler_capacity_kw": { "type": "number", "exclusiveMinimum": 0, "default": 100 },
        "chiller_capacity_kw": { "type": "number", "exclusiveMinimum": 0, "default": 100 },
        "step_seconds": { "type": "integer", "enum": [15, 30, 60, 300, 900], "default": 900 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["x", "y"],
        "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["name", "block_type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "block_type": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "notes": { "type": "string" },
        "brick_model": { "$ref": "#/$defs/brickModel" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/connector" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/connector" } },
        "parameters": { "type": "array", "items": { "type": "object", "required": ["name", "value"] } },
        "equations": { "type": "array", "items": { "type": "object", "required": ["lhs", "rhs"] } },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "connections": { "type": "array", "items": { "type": "object" } }
      }
    },
    "brickModel": {
      "type": "object",
      "required": ["entities", "relationships"],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "class", "label"],
            "properties": {
              "id": { "type": "string" },
              "class": { "type": "string" },
              "label": { "type": "string" },
              "controller": { "type": "string" },
              "connector": { "type": "string" }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["subject", "predicate", "object"],
            "properties": {
              "subject": { "type": "string" },
              "predicate": { "enum": ["brick:hasPart", "brick:feeds", "brick:hasPoint"] },
              "object": { "type": "string" }
            }
          }
        }
      }
    },
    "connector": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["Real", "Integer", "Boolean", "String"] },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "unit": { "type": "string" },
        "brick_class": { "type": "string", "description": "Brick point class local name, such as Zone_Air_Temperature_Sensor" }
      }
    }
  }
}
