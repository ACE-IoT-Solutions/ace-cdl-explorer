{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "WebWorker"],
    "strict": true, "skipLibCheck": true, "isolatedModules": true, "allowImportingTsExtensions": true,
    "types": ["vite/client"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"]
}
