{
  "name": "ace-cdl-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test:cxf": "tsx --test tests/cxf.test.ts",
    "test:graph": "tsx --test tests/graphRouting.test.ts tests/layout.test.ts tests/signalUnits.test.ts",
    "build": "npm run test:graph && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "apache-arrow": "^21.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/jsonld": "^1.5.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsonld": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
