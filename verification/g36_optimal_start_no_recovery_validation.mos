// Same pinned Modelica Buildings checkout and OpenModelica setup as the
// completed-recovery validation, with a recovery that stays 0.05 K short.
loadModel(Modelica);
loadFile("/src/Buildings/package.mo");
loadFile("/work/verification/g36_optimal_start_no_recovery_validation.mo");
checkModel(ACEOptimalStartNoRecovery);
simulate(ACEOptimalStartNoRecovery, startTime=0, stopTime=259200,
  numberOfIntervals=4320, tolerance=1e-8, outputFormat="csv");
getErrorString();
